{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/icons/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/uz/assosiy", "destination": "/", "permanent": true },
    { "source": "/uz/assosiy/", "destination": "/", "permanent": true },
    { "source": "/ru/главная", "destination": "/ru/", "permanent": true },
    { "source": "/ru/главная/", "destination": "/ru/", "permanent": true },
    { "source": "/ru/%D0%B3%D0%BB%D0%B0%D0%B2%D0%BD%D0%B0%D1%8F", "destination": "/ru/", "permanent": true },
    { "source": "/ru/%D0%B3%D0%BB%D0%B0%D0%B2%D0%BD%D0%B0%D1%8F/", "destination": "/ru/", "permanent": true },

    { "source": "/terms-of-usage", "destination": "/en/terms/", "permanent": true },
    { "source": "/terms-of-usage/", "destination": "/en/terms/", "permanent": true },
    { "source": "/privacy-policy", "destination": "/en/privacy/", "permanent": true },
    { "source": "/privacy-policy/", "destination": "/en/privacy/", "permanent": true },

    { "source": "/uz/londry-oz-oziga-xizmat-korsatish-kir-yuvish-xonasidan-foydalanish-shartlari", "destination": "/terms/", "permanent": true },
    { "source": "/uz/londry-oz-oziga-xizmat-korsatish-kir-yuvish-xonasidan-foydalanish-shartlari/", "destination": "/terms/", "permanent": true },
    { "source": "/uz/maxfiylik-siyosati", "destination": "/privacy/", "permanent": true },
    { "source": "/uz/maxfiylik-siyosati/", "destination": "/privacy/", "permanent": true },

    { "source": "/ru/условия-использования-прачечной-сам", "destination": "/ru/terms/", "permanent": true },
    { "source": "/ru/условия-использования-прачечной-сам/", "destination": "/ru/terms/", "permanent": true },
    { "source": "/ru/%D1%83%D1%81%D0%BB%D0%BE%D0%B2%D0%B8%D1%8F-%D0%B8%D1%81%D0%BF%D0%BE%D0%BB%D1%8C%D0%B7%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D1%8F-%D0%BF%D1%80%D0%B0%D1%87%D0%B5%D1%87%D0%BD%D0%BE%D0%B9-%D1%81%D0%B0%D0%BC", "destination": "/ru/terms/", "permanent": true },
    { "source": "/ru/%D1%83%D1%81%D0%BB%D0%BE%D0%B2%D0%B8%D1%8F-%D0%B8%D1%81%D0%BF%D0%BE%D0%BB%D1%8C%D0%B7%D0%BE%D0%B2%D0%B0%D0%BD%D0%B8%D1%8F-%D0%BF%D1%80%D0%B0%D1%87%D0%B5%D1%87%D0%BD%D0%BE%D0%B9-%D1%81%D0%B0%D0%BC/", "destination": "/ru/terms/", "permanent": true },
    { "source": "/ru/политика-конфиденциальности", "destination": "/ru/privacy/", "permanent": true },
    { "source": "/ru/политика-конфиденциальности/", "destination": "/ru/privacy/", "permanent": true },
    { "source": "/ru/%D0%BF%D0%BE%D0%BB%D0%B8%D1%82%D0%B8%D0%BA%D0%B0-%D0%BA%D0%BE%D0%BD%D1%84%D0%B8%D0%B4%D0%B5%D0%BD%D1%86%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE%D1%81%D1%82%D0%B8", "destination": "/ru/privacy/", "permanent": true },
    { "source": "/ru/%D0%BF%D0%BE%D0%BB%D0%B8%D1%82%D0%B8%D0%BA%D0%B0-%D0%BA%D0%BE%D0%BD%D1%84%D0%B8%D0%B4%D0%B5%D0%BD%D1%86%D0%B8%D0%B0%D0%BB%D1%8C%D0%BD%D0%BE%D1%81%D1%82%D0%B8/", "destination": "/ru/privacy/", "permanent": true }
  ]
}
