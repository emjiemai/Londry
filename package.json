{
  "name": "londry-uz",
  "private": true,
  "version": "0.1.0-beta.1",
  "description": "londry.uz — landing site for Londry self-service laundry and SPOTX aqua cleaning (Tashkent)",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run e2e",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1",
    "vitest": "^5.0.5"
  }
}
