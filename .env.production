# Used by `npm run build`. Not secret: these values end up in the public HTML.

# Public address of the site (no trailing slash). Canonical links, sitemap and share previews use it.
VITE_SITE_URL=https://londry.uz

# BETA: the site is hidden from Google/Yandex (noindex + Disallow in robots.txt).
# On launch day change this to "true" and rebuild.
VITE_INDEXABLE=false
