{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Build-time entry and the i18n provider+hook pair are not hot-reloaded component files.
      "files": ["src/entry-server.tsx", "src/i18n/context.tsx"],
      "rules": { "react/only-export-components": "off" }
    }
  ],
  "ignorePatterns": ["dist", "dist-ssr", "node_modules", "scripts/*.py"]
}
